{
  "name": "weddingplan",
  "version": "1.0.0",
  "description": "Wedding SS – persönliche Hochzeitsplanung, Alles im Blick",
  "scripts": {
    "test": "npm run build && npm run test:unit && playwright test",
    "dev": "node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "node server/index.mjs --production",
    "test:e2e": "playwright test",
    "format": "prettier --write src server scripts tests playwright.config.ts index.html README.md",
    "start": "node server/index.mjs --production",
    "test:unit": "node --test tests/server.test.mjs tests/extract.test.mjs tests/guest-import.test.mjs tests/offer-conflicts.test.mjs",
    "backup": "node scripts/backup.mjs",
    "build:cloud": "node scripts/prepare-browser-ocr.mjs && tsc --noEmit && vite build --mode cloud --outDir dist-cloud"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saranravichandra-oss/weddingplan.git"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "bugs": {
    "url": "https://github.com/saranravichandra-oss/weddingplan/issues"
  },
  "homepage": "https://github.com/saranravichandra-oss/weddingplan#readme",
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@napi-rs/canvas": "1.0.13",
    "@phosphor-icons/react": "^2.1.10",
    "@tesseract.js-data/deu": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "multer": "2.5.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "read-excel-file": "9.3.13",
    "tesseract.js": "7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fflate": "0.8.3",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  }
}
